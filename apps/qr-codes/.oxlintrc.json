{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "jsx-a11y",
    "nextjs",
    "promise",
    "jsdoc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "maxWarnings": 0,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "next-env.d.ts",
    "src/components/shadcn-ui/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    // requireAdmin ends in redirect() (returns never) — consistent-return can't see that and false-positives.
    "typescript/consistent-return": "off",
    // Side-effect imports (`import "server-only"`, global CSS) are intentional and carry no binding.
    "import/no-unassigned-import": "off",
    // Inline `'use server'` actions must live in component scope to bind as Server Actions; moving them out breaks that.
    "unicorn/consistent-function-scoping": "off"
  },
  "overrides": [
    {
      "files": ["src/**/*.{js,jsx,ts,tsx}"],
      "rules": {
        "max-lines": ["error", { "max": 200, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      "files": ["src/**/*.test.{js,jsx,ts,tsx}"],
      "rules": {
        "max-lines": "off"
      }
    }
  ]
}
