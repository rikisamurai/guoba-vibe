{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "types": ["node", "react", "react-native", "vitest/globals"]
  },
  "include": [
    ".rnstorybook/**/*.ts",
    ".rnstorybook/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "vitest.config.ts",
    "vitest.setup.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
