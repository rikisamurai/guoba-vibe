{
  "name": "guoba-vibe",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter qr-codes dev",
    "build": "pnpm --filter qr-codes build",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "start": "pnpm --filter qr-codes start",
    "lint": "pnpm --filter qr-codes lint",
    "test": "pnpm --filter qr-codes test",
    "prepare": "simple-git-hooks",
    "dev:qr-vault": "pnpm --filter qr-vault dev",
    "build:qr-vault": "pnpm --filter qr-vault build",
    "lint:qr-vault": "pnpm --filter qr-vault lint",
    "preview:qr-vault": "pnpm --filter qr-vault preview",
    "test:qr-vault": "pnpm --filter qr-vault test"
  },
  "devDependencies": {
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.52.0",
    "react-doctor": "^0.2.6",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,json5,yml,yaml,css,scss,md,mdx,html}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.3.0"
}
